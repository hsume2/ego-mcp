# Copy to .env (never commit .env), or to instances/<name>.env for multiple instances.

# Instance name: compose project and container become ego-mcp-<name>.
EGO_MCP_INSTANCE=default

# Bearer token MCP clients must send. Generate with: openssl rand -hex 32
EGO_MCP_HTTP_TOKEN=

# Host port / interface to publish on. Defaults to the Docker bridge gateway
# (docker0) so only this host and its containers can reach it. Check yours with:
#   docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}'
# Use 0.0.0.0 to expose on the LAN, or 127.0.0.1 for host-only.
EGO_MCP_HTTP_PORT=8765
EGO_MCP_HTTP_BIND=172.17.0.1

# Embeddings: self-hosted OpenAI-compatible server (e.g. bge-m3 on the LAN).
EGO_MCP_EMBEDDING_PROVIDER=openai
EGO_MCP_EMBEDDING_MODEL=bge-m3
EGO_MCP_EMBEDDING_BASE_URL=http://192.168.1.20:8080/v1
OPENAI_API_KEY=your-embedding-server-bearer-token

# Host directories mounted for data and JSONL logs, and the uid:gid that owns them.
EGO_MCP_DATA_MOUNT=./data
EGO_MCP_LOG_MOUNT=./logs
EGO_MCP_UID=1000
EGO_MCP_GID=1000

EGO_MCP_COMPANION_NAME=Master
EGO_MCP_TIMEZONE=UTC
